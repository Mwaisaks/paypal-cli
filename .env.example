# Create a REST app at https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default) or live
PAYPAL_ENV=sandbox
# Optional: the webhook used by `trigger` and `doctor`
PAYPAL_WEBHOOK_ID=
# Optional: enables the AI part of `paypal-cli explain` (rules-only without it)
ANTHROPIC_API_KEY=
